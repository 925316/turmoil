<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\Build\$(Configuration)\</OutputPath>
    <AssemblyName>tmmod</AssemblyName>
    <RootNamespace>tmmod</RootNamespace>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Games\Turmoil\Turmoil_Data\Managed</GameManaged>
  </PropertyGroup>

  <!--
    BepInEx/0Harmony come from lib\ (extracted from the official x64 pack, not committed).
    UnityEngine.CoreModule is referenced straight from the game install: game types are
    reached via runtime reflection, so no stub projects and no committed binaries.
    Private=false keeps all references out of the output folder; at runtime they bind
    to the real game-loaded assemblies.
  -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\..\lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
